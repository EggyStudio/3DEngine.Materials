<Project Sdk="Microsoft.NET.Sdk">

    <!-- The library an engine references from a project of its own, which knows no engine
         (N 2.1). -->
    <PropertyGroup>
        <AssemblyName>3DEngine.Materials</AssemblyName>
        <PackageId>3DEngine.Materials</PackageId>
        <RootNamespace>Materials</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Every public member has a summary (STYLE.md), so a missing one stops the build, as a cref
         that names nothing does. -->
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1574</WarningsAsErrors>
    </PropertyGroup>

</Project>
